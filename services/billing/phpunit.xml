<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- The container exports CACHE_STORE=redis in $_SERVER, which Laravel reads first; tests must not touch the shared Redis. -->
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="mestaro_billing_test" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="TRUSTED_PROXIES" value="" force="true"/>
        <!-- Own streams: tests must never touch the dev stream that live consumers read. -->
        <env name="EVENTS_STREAM" value="mestaro.events.test.billing" force="true"/>
        <env name="EVENTS_DEAD_STREAM" value="mestaro.events.test.billing.dead" force="true"/>
        <server name="EVENTS_STREAM" value="mestaro.events.test.billing" force="true"/>
        <server name="EVENTS_DEAD_STREAM" value="mestaro.events.test.billing.dead" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <server name="DB_DATABASE" value="mestaro_billing_test" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="TRUSTED_PROXIES" value="" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
