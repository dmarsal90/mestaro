{
    "name": "mestaro/shared-kernel",
    "description": "Code every Mestaro service shares: outbox, event consumer, JWT verification, tenant database access. No business rules.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^7.2",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/redis": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Mestaro\\Kernel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mestaro\\Kernel\\KernelServiceProvider"
            ]
        }
    }
}
