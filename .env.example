COMPOSE_PROJECT_NAME=mestaro
HOST_UID=1000
HOST_GID=1000

GATEWAY_PORT=8100
MAILPIT_PORT=8125

# Postgres superuser (container init only). Fill locally; never commit.
POSTGRES_PASSWORD=
PLATFORM_DB_PASSWORD=
CATALOG_DB_PASSWORD=

REDIS_PASSWORD=
PLATFORM_APP_KEY=
CATALOG_APP_KEY=
# Ed25519 signing key: docker compose exec platform php artisan jwt:generate-key
PLATFORM_JWT_PRIVATE_KEY=

# Comma-separated services that must report TenantProvisioned before a restaurant activates.
TENANCY_SERVICES=platform,catalog
